{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/backlog/src/cli.mjs\" --hook session-start 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking BACKLOG.md review queue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/backlog/src/cli.mjs\" --hook prompt 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
