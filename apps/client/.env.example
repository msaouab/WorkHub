# Do not set NODE_ENV here — Next.js sets it per command (dev/build/start).
# Setting NODE_ENV=development in env files breaks `next build`.

PORT=3000

# Public web app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API origin (no trailing slash, no /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Must match server API_PREFIX
NEXT_PUBLIC_API_PREFIX=api/v1
