{
  "name": "@work-hub/client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start"
  },
  "nx": {
    "sourceRoot": "apps/client/src",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/.next"
        ],
        "options": {
          "cwd": "apps/client",
          "command": "next build --webpack"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/client",
          "command": "next dev"
        }
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  }
}
