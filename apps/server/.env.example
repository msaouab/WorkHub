# Runtime
NODE_ENV=development

# Bind address (use 0.0.0.0 in containers)
HOST=0.0.0.0
PORT=3333

# Public API URL used in logs + OpenAPI servers (no trailing slash)
APP_URL=http://localhost:3333

# Routing
API_PREFIX=api/v1
SWAGGER_PATH=docs
# Allowed: true | false | 1 | 0. Defaults to true outside production when omitted.
SWAGGER_ENABLED=true

# Postgres — runtime app role (created by docker/postgres/init/01-app-role.sql)
DATABASE_URL=postgresql://workhub_app:workhub_app@localhost:5434/workhub
# Prisma CLI only (migrate/studio) — owner role (POSTGRES_USER)
DATABASE_MIGRATION_URL=postgresql://workhub:workhub@localhost:5434/workhub

# Comma-separated absolute origins (must be valid URLs)
CORS_ORIGINS=http://localhost:3000

# Better Auth — secret for signing session cookies and tokens
BETTER_AUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32

# Mail — Mailpit locally (inbox: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS from the first byte (port 465); false = plain or STARTTLS (1025, 587)
SMTP_SECURE=false
# Leave both empty for Mailpit; set both for a real provider
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkHub <no-reply@workhub.local>"

# Object storage — MinIO locally (docker compose --env-file apps/server/.env; console http://localhost:9001)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wh-test-bucket
STORAGE_ACCESS_KEY=wh-test-access-key
STORAGE_SECRET_KEY=wh-test-secret-key
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/workhub
STORAGE_FORCE_PATH_STYLE=true

# SEED_PASSWORD=workhub-dev-1   # optional, used by pnpm db:seed
