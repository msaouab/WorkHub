# Runtime
NODE_ENV=development

# Bind address (use 0.0.0.0 in containers)
HOST=0.0.0.0
PORT=3333

# Public API URL used in logs + OpenAPI servers (no trailing slash)
APP_URL=http://localhost:3333

# Routing
API_PREFIX=api/v1
SWAGGER_PATH=docs
# Allowed: true | false | 1 | 0. Defaults to true outside production when omitted.
SWAGGER_ENABLED=true

# Comma-separated absolute origins (must be valid URLs)
CORS_ORIGINS=http://localhost:3000
