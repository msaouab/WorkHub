# Runtime
NODE_ENV=development

# Bind address (use 0.0.0.0 in containers)
HOST=0.0.0.0
PORT=3333

# Public API URL used in logs + OpenAPI servers (no trailing slash)
APP_URL=http://localhost:3333

# Routing
API_PREFIX=api/v1
SWAGGER_PATH=docs
# Allowed: true | false | 1 | 0. Defaults to true outside production when omitted.
SWAGGER_ENABLED=true

# Postgres — runtime app role (created by docker/postgres/init/01-app-role.sql)
DATABASE_URL=postgresql://workhub_app:workhub_app@localhost:5434/workhub
# Prisma CLI only (migrate/studio) — owner role (POSTGRES_USER)
DATABASE_MIGRATION_URL=postgresql://workhub:workhub@localhost:5434/workhub

# Comma-separated absolute origins (must be valid URLs)
CORS_ORIGINS=http://localhost:3000

# Mail — Mailpit locally (inbox: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS from the first byte (port 465); false = plain or STARTTLS (1025, 587)
SMTP_SECURE=false
# Leave both empty for Mailpit; set both for a real provider
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkHub <no-reply@workhub.local>"
