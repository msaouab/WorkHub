NODE_ENV=production
HOST=0.0.0.0
PORT=3333
APP_URL=https://api.example.com
API_PREFIX=api/v1
SWAGGER_PATH=docs
# Allowed: true | false | 1 | 0 (omit to default off in production)
SWAGGER_ENABLED=false
# Comma-separated absolute origins (must be valid URLs)
CORS_ORIGINS=https://app.example.com

# Postgres — runtime app role (least privilege)
DATABASE_URL=postgresql://workhub_app:CHANGE_ME@db-host:5432/workhub
# Prisma CLI only (migrate/studio) — owner role
DATABASE_MIGRATION_URL=postgresql://workhub:CHANGE_ME@db-host:5432/workhub

# Mail — real SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
MAIL_FROM="WorkHub <no-reply@example.com>"
