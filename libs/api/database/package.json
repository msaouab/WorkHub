{
  "name": "@work-hub/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@work-hub/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --no-hints"
  },
  "nx": {
    "tags": [
      "scope:api",
      "type:data-access"
    ],
    "targets": {
      "db:generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "options": {
          "cwd": "libs/api/database",
          "command": "prisma generate --no-hints"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/api/database",
          "command": "prisma migrate dev"
        }
      },
      "db:deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/api/database",
          "command": "prisma migrate deploy"
        }
      },
      "db:studio": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/api/database",
          "command": "prisma studio"
        }
      }
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.7",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
