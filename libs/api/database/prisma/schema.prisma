generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" // the server is bundled by webpack into CommonJS
}

datasource db {
  provider = "postgresql"
  // Prisma 7: no url here — the CLI reads prisma.config.ts, the runtime uses the driver adapter.
}

// Models arrive in Step 2 (Better Auth: User, Account, Session, Verification).
// Conventions: @id @default(uuid(7)) @db.Uuid · @db.Timestamptz(6) · @map/@@map to snake_case.

enum Locale {
  en
  ar
  fr
}

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique @db.Citext
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  invitesCreated Invite[] @relation("InviteCreatedBy")

  locale        Locale    @default(en)

  @@map("users")
}

enum MembershipStatus {
  active
  deactivated
}

model Space {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String    @unique @db.Citext
  defaultRoleId   String?   @unique @map("default_role_id") @db.Uuid
  logoKey         String?   @map("logo_key")
  coverKey        String?   @map("cover_key")
  coverPreset     String?   @map("cover_preset")
  coverPositionY  Int       @default(50) @map("cover_position_y") @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  defaultRole Role?         @relation("SpaceDefaultRole", fields: [defaultRoleId], references: [id], onDelete: Restrict)
  roles       Role[]        @relation("SpaceRoles")
  memberships Membership[]
  invites     Invite[]
  teams       Team[]

  @@map("spaces")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  name        String
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  space           Space         @relation("SpaceRoles", fields: [spaceId], references: [id], onDelete: Cascade)
  defaultForSpace Space?        @relation("SpaceDefaultRole")
  memberships     Membership[]
  invites         Invite[]

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("roles")
}

enum InviteKind {
  email
  link
}

/** Workspace invite (email or link). Only `token_hash` is stored (WH-010). */
model Invite {
  id        String     @id @default(uuid(7)) @db.Uuid
  spaceId   String     @map("space_id") @db.Uuid
  roleId    String     @map("role_id") @db.Uuid
  kind      InviteKind
  email     String?    @db.Citext
  tokenHash String     @unique @map("token_hash")
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  maxUses   Int        @map("max_uses")
  uses      Int        @default(0)
  revokedAt DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdBy String     @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  space   Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  creator User  @relation("InviteCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([spaceId, email])
  @@map("invites")
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  spaceId   String           @map("space_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  teamMemberships TeamMember[]
  teamManagerOf   TeamManager[]

  @@unique([spaceId, userId])
  /** Composite target for team_members / team_managers same-space FKs (WH-058). */
  @@unique([id, spaceId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

/** Workspace group (UI: “Groups”; API/DB: teams) — WH-058. */
model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  managers  TeamManager[]

  @@unique([spaceId, name])
  /** Composite target for team_members / team_managers same-space FKs (WH-058). */
  @@unique([id, spaceId])
  @@index([spaceId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid(7)) @db.Uuid
  spaceId      String   @map("space_id") @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [teamId, spaceId], references: [id, spaceId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, spaceId], references: [id, spaceId], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([spaceId])
  @@index([membershipId])
  @@map("team_members")
}

model TeamManager {
  id           String   @id @default(uuid(7)) @db.Uuid
  spaceId      String   @map("space_id") @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [teamId, spaceId], references: [id, spaceId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, spaceId], references: [id, spaceId], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([spaceId])
  @@index([membershipId])
  @@map("team_managers")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id") // provider's user id ("credential" → user id)
  providerId            String    @map("provider_id") // credential | google | github | microsoft | gitlab
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String? // argon2id hash, credential accounts only
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String // email, or "reset-password:<token>"
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}
